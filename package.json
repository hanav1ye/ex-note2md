{
  "name": "ex-note2md",
  "private": true,
  "version": "1.1.0",
  "description": "Build helpers for ex-note2md extension.",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:dist": "node scripts/test-dist.mjs",
    "verify": "npm run lint && npm test",
    "build:dist": "node scripts/build-dist.mjs",
